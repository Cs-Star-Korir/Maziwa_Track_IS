                <mxCell id="payments" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&#39;margin:4px;text-align:center&#39;&gt;&lt;b&gt;payments&lt;/b&gt;&lt;/p&gt;&lt;table border=&#39;1&#39; cellpadding=&#39;3&#39; style=&#39;border-collapse:collapse;width:100%;font-size:11px&#39;&gt;&lt;tr style=&#39;background:#e6e6e6&#39;&gt;&lt;th align=&#39;left&#39;&gt;Column&lt;/th&gt;&lt;th align=&#39;left&#39;&gt;Type&lt;/th&gt;&lt;th align=&#39;left&#39;&gt;Constraints&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;u&gt;payment_id&lt;/u&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;integer&lt;/td&gt;&lt;td&gt;PK, identity&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;i&gt;batch_id&lt;/i&gt;&lt;/td&gt;&lt;td&gt;integer&lt;/td&gt;&lt;td&gt;FK → batches, UNIQUE, NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;i&gt;admin_id&lt;/i&gt;&lt;/td&gt;&lt;td&gt;integer&lt;/td&gt;&lt;td&gt;FK → users, NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;price_per_litre&lt;/td&gt;&lt;td&gt;numeric(8,2)&lt;/td&gt;&lt;td&gt;NOT NULL, CHECK &amp;gt; 0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;payment_reference&lt;/td&gt;&lt;td&gt;varchar(30)&lt;/td&gt;&lt;td&gt;UNIQUE, NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;email_sent&lt;/td&gt;&lt;td&gt;boolean&lt;/td&gt;&lt;td&gt;DEFAULT false&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;approved_at&lt;/td&gt;&lt;td&gt;timestamptz&lt;/td&gt;&lt;td&gt;DEFAULT now()&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
