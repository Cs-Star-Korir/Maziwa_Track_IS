                <mxCell id="audit" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&#39;margin:4px;text-align:center&#39;&gt;&lt;b&gt;audit_logs&lt;/b&gt;&lt;/p&gt;&lt;table border=&#39;1&#39; cellpadding=&#39;3&#39; style=&#39;border-collapse:collapse;width:100%;font-size:11px&#39;&gt;&lt;tr style=&#39;background:#e6e6e6&#39;&gt;&lt;th align=&#39;left&#39;&gt;Column&lt;/th&gt;&lt;th align=&#39;left&#39;&gt;Type&lt;/th&gt;&lt;th align=&#39;left&#39;&gt;Constraints&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;u&gt;log_id&lt;/u&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;integer&lt;/td&gt;&lt;td&gt;PK, identity&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;i&gt;user_id&lt;/i&gt;&lt;/td&gt;&lt;td&gt;integer&lt;/td&gt;&lt;td&gt;FK → users, NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;action&lt;/td&gt;&lt;td&gt;varchar(50)&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;table_name&lt;/td&gt;&lt;td&gt;varchar(50)&lt;/td&gt;&lt;td&gt;NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;record_id&lt;/td&gt;&lt;td&gt;integer&lt;/td&gt;&lt;td&gt;NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;old_value&lt;/td&gt;&lt;td&gt;jsonb&lt;/td&gt;&lt;td&gt;NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;new_value&lt;/td&gt;&lt;td&gt;jsonb&lt;/td&gt;&lt;td&gt;NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;created_at&lt;/td&gt;&lt;td&gt;timestamptz&lt;/td&gt;&lt;td&gt;DEFAULT now()&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
