                <mxCell id="key" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;spacing=6;" value="&lt;b&gt;Key:&lt;/b&gt; &lt;b&gt;&lt;u&gt;bold underlined&lt;/u&gt;&lt;/b&gt; = primary key (PK) &amp;nbsp;|&amp;nbsp; &lt;i&gt;italic&lt;/i&gt; = foreign key (FK) &amp;nbsp;|&amp;nbsp; identity = auto-generated number &amp;nbsp;|&amp;nbsp; Payment amount = measured_litres × price_per_litre (calculated, not stored)" vertex="1">
