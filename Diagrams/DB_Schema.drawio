                <mxCell id="batches" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;p style=&#39;margin:4px;text-align:center&#39;&gt;&lt;b&gt;batches&lt;/b&gt;&lt;/p&gt;&lt;table border=&#39;1&#39; cellpadding=&#39;3&#39; style=&#39;border-collapse:collapse;width:100%;font-size:11px&#39;&gt;&lt;tr style=&#39;background:#e6e6e6&#39;&gt;&lt;th align=&#39;left&#39;&gt;Column&lt;/th&gt;&lt;th align=&#39;left&#39;&gt;Type&lt;/th&gt;&lt;th align=&#39;left&#39;&gt;Constraints&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;u&gt;batch_id&lt;/u&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;integer&lt;/td&gt;&lt;td&gt;PK, identity&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;batch_number&lt;/td&gt;&lt;td&gt;varchar(20)&lt;/td&gt;&lt;td&gt;UNIQUE, NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;i&gt;farmer_id&lt;/i&gt;&lt;/td&gt;&lt;td&gt;integer&lt;/td&gt;&lt;td&gt;FK → users, NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;declared_litres&lt;/td&gt;&lt;td&gt;numeric(8,2)&lt;/td&gt;&lt;td&gt;NOT NULL, CHECK &amp;gt; 0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;status&lt;/td&gt;&lt;td&gt;varchar(10)&lt;/td&gt;&lt;td&gt;CHECK recorded / passed / rejected / paid&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;delivered_at&lt;/td&gt;&lt;td&gt;timestamptz&lt;/td&gt;&lt;td&gt;DEFAULT now()&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;i&gt;grader_id&lt;/i&gt;&lt;/td&gt;&lt;td&gt;integer&lt;/td&gt;&lt;td&gt;FK → users, NULL until tested&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;measured_litres&lt;/td&gt;&lt;td&gt;numeric(8,2)&lt;/td&gt;&lt;td&gt;CHECK &amp;gt; 0, NULL until tested&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;quality_result&lt;/td&gt;&lt;td&gt;varchar(6)&lt;/td&gt;&lt;td&gt;CHECK pass / reject&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;grader_notes&lt;/td&gt;&lt;td&gt;text&lt;/td&gt;&lt;td&gt;NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;tested_at&lt;/td&gt;&lt;td&gt;timestamptz&lt;/td&gt;&lt;td&gt;NULL until tested&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
