        <mxCell id="users" parent="sB9-z2WvRSnQyfvKPkuS-2" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;p style=&#39;margin:4px;text-align:center&#39;&gt;&lt;b&gt;users&lt;/b&gt;&lt;/p&gt;&lt;table border=&#39;1&#39; cellpadding=&#39;3&#39; style=&#39;border-collapse:collapse;width:100%;font-size:11px&#39;&gt;&lt;tr style=&#39;background:#e6e6e6&#39;&gt;&lt;th align=&#39;left&#39;&gt;Column&lt;/th&gt;&lt;th align=&#39;left&#39;&gt;Type&lt;/th&gt;&lt;th align=&#39;left&#39;&gt;Constraints&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;u&gt;user_id&lt;/u&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;INT UNSIGNED&lt;/td&gt;&lt;td&gt;PK, AUTO_INCREMENT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;full_name&lt;/td&gt;&lt;td&gt;VARCHAR(100)&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;email&lt;/td&gt;&lt;td&gt;VARCHAR(255)&lt;/td&gt;&lt;td&gt;UNIQUE, NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;phone&lt;/td&gt;&lt;td&gt;VARCHAR(20)&lt;/td&gt;&lt;td&gt;UNIQUE, NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;password_hash&lt;/td&gt;&lt;td&gt;TEXT&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;role&lt;/td&gt;&lt;td&gt;ENUM(&#39;farmer&#39;,&#39;grader&#39;,&#39;admin&#39;)&lt;/td&gt;&lt;td&gt;NOT NULL, DEFAULT &#39;farmer&#39;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;is_active&lt;/td&gt;&lt;td&gt;BOOLEAN&lt;/td&gt;&lt;td&gt;NOT NULL, DEFAULT TRUE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;created_at&lt;/td&gt;&lt;td&gt;TIMESTAMP&lt;/td&gt;&lt;td&gt;NOT NULL, DEFAULT CURRENT_TIMESTAMP&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="250" width="430" y="45" as="geometry" />
        </mxCell>
        <mxCell id="batches" parent="sB9-z2WvRSnQyfvKPkuS-2" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;p style=&#39;margin:4px;text-align:center&#39;&gt;&lt;b&gt;batches&lt;/b&gt;&lt;/p&gt;&lt;table border=&#39;1&#39; cellpadding=&#39;3&#39; style=&#39;border-collapse:collapse;width:100%;font-size:11px&#39;&gt;&lt;tr style=&#39;background:#e6e6e6&#39;&gt;&lt;th align=&#39;left&#39;&gt;Column&lt;/th&gt;&lt;th align=&#39;left&#39;&gt;Type&lt;/th&gt;&lt;th align=&#39;left&#39;&gt;Constraints&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;u&gt;batch_id&lt;/u&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;INT UNSIGNED&lt;/td&gt;&lt;td&gt;PK, AUTO_INCREMENT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;batch_number&lt;/td&gt;&lt;td&gt;VARCHAR(20)&lt;/td&gt;&lt;td&gt;UNIQUE, NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;i&gt;farmer_id&lt;/i&gt;&lt;/td&gt;&lt;td&gt;INT UNSIGNED&lt;/td&gt;&lt;td&gt;FK → users, NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;declared_litres&lt;/td&gt;&lt;td&gt;DECIMAL(8,2)&lt;/td&gt;&lt;td&gt;NOT NULL, CHECK &amp;gt; 0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;status&lt;/td&gt;&lt;td&gt;ENUM(&#39;recorded&#39;,&#39;passed&#39;,&#39;rejected&#39;,&#39;paid&#39;)&lt;/td&gt;&lt;td&gt;NOT NULL, DEFAULT &#39;recorded&#39;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;delivered_at&lt;/td&gt;&lt;td&gt;TIMESTAMP&lt;/td&gt;&lt;td&gt;NOT NULL, DEFAULT CURRENT_TIMESTAMP&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;i&gt;grader_id&lt;/i&gt;&lt;/td&gt;&lt;td&gt;INT UNSIGNED&lt;/td&gt;&lt;td&gt;FK → users, NULL until tested&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;measured_litres&lt;/td&gt;&lt;td&gt;DECIMAL(8,2)&lt;/td&gt;&lt;td&gt;CHECK &amp;gt; 0, NULL until tested&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;quality_result&lt;/td&gt;&lt;td&gt;ENUM(&#39;pass&#39;,&#39;reject&#39;)&lt;/td&gt;&lt;td&gt;NULL until tested&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;grader_notes&lt;/td&gt;&lt;td&gt;TEXT&lt;/td&gt;&lt;td&gt;NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;tested_at&lt;/td&gt;&lt;td&gt;TIMESTAMP&lt;/td&gt;&lt;td&gt;NULL until tested&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="330" width="430" x="445" y="45" as="geometry" />
        </mxCell>
        <mxCell id="audit_logs" parent="sB9-z2WvRSnQyfvKPkuS-2" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&#39;margin:4px;text-align:center&#39;&gt;&lt;b&gt;audit_logs&lt;/b&gt;&lt;/p&gt;&lt;table border=&#39;1&#39; cellpadding=&#39;3&#39; style=&#39;border-collapse:collapse;width:100%;font-size:11px&#39;&gt;&lt;tr style=&#39;background:#e6e6e6&#39;&gt;&lt;th align=&#39;left&#39;&gt;Column&lt;/th&gt;&lt;th align=&#39;left&#39;&gt;Type&lt;/th&gt;&lt;th align=&#39;left&#39;&gt;Constraints&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;u&gt;log_id&lt;/u&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;INT UNSIGNED&lt;/td&gt;&lt;td&gt;PK, AUTO_INCREMENT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;i&gt;user_id&lt;/i&gt;&lt;/td&gt;&lt;td&gt;INT UNSIGNED&lt;/td&gt;&lt;td&gt;FK → users, NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;action&lt;/td&gt;&lt;td&gt;VARCHAR(50)&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;table_name&lt;/td&gt;&lt;td&gt;VARCHAR(50)&lt;/td&gt;&lt;td&gt;NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;record_id&lt;/td&gt;&lt;td&gt;INT UNSIGNED&lt;/td&gt;&lt;td&gt;NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;old_value&lt;/td&gt;&lt;td&gt;JSON&lt;/td&gt;&lt;td&gt;NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;new_value&lt;/td&gt;&lt;td&gt;JSON&lt;/td&gt;&lt;td&gt;NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;created_at&lt;/td&gt;&lt;td&gt;TIMESTAMP&lt;/td&gt;&lt;td&gt;NOT NULL, DEFAULT CURRENT_TIMESTAMP&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="250" width="430" y="315" as="geometry" />
        </mxCell>
        <mxCell id="payments" parent="sB9-z2WvRSnQyfvKPkuS-2" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&#39;margin:4px;text-align:center&#39;&gt;&lt;b&gt;payments&lt;/b&gt;&lt;/p&gt;&lt;table border=&#39;1&#39; cellpadding=&#39;3&#39; style=&#39;border-collapse:collapse;width:100%;font-size:11px&#39;&gt;&lt;tr style=&#39;background:#e6e6e6&#39;&gt;&lt;th align=&#39;left&#39;&gt;Column&lt;/th&gt;&lt;th align=&#39;left&#39;&gt;Type&lt;/th&gt;&lt;th align=&#39;left&#39;&gt;Constraints&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;u&gt;payment_id&lt;/u&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;INT UNSIGNED&lt;/td&gt;&lt;td&gt;PK, AUTO_INCREMENT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;i&gt;batch_id&lt;/i&gt;&lt;/td&gt;&lt;td&gt;INT UNSIGNED&lt;/td&gt;&lt;td&gt;FK → batches, UNIQUE, NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;i&gt;admin_id&lt;/i&gt;&lt;/td&gt;&lt;td&gt;INT UNSIGNED&lt;/td&gt;&lt;td&gt;FK → users, NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;price_per_litre&lt;/td&gt;&lt;td&gt;DECIMAL(8,2)&lt;/td&gt;&lt;td&gt;NOT NULL, CHECK &amp;gt; 0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;payment_reference&lt;/td&gt;&lt;td&gt;VARCHAR(30)&lt;/td&gt;&lt;td&gt;UNIQUE, NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;email_sent&lt;/td&gt;&lt;td&gt;BOOLEAN&lt;/td&gt;&lt;td&gt;NOT NULL, DEFAULT FALSE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;approved_at&lt;/td&gt;&lt;td&gt;TIMESTAMP&lt;/td&gt;&lt;td&gt;NOT NULL, DEFAULT CURRENT_TIMESTAMP&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="235" width="430" x="445" y="395" as="geometry" />
        </mxCell>
        <mxCell id="key" parent="sB9-z2WvRSnQyfvKPkuS-2" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;spacing=6;" value="&lt;b&gt;Key:&lt;/b&gt; &lt;b&gt;&lt;u&gt;bold underlined&lt;/u&gt;&lt;/b&gt; = primary key (PK) &amp;nbsp;|&amp;nbsp; &lt;i&gt;italic&lt;/i&gt; = foreign key (FK) &amp;nbsp;|&amp;nbsp; AUTO_INCREMENT = number generated by MySQL &amp;nbsp;|&amp;nbsp; ENUM = only the listed values are allowed &amp;nbsp;|&amp;nbsp; All tables use InnoDB, utf8mb4 &amp;nbsp;|&amp;nbsp; Payment amount = measured_litres × price_per_litre (calculated, not stored)" vertex="1">
          <mxGeometry height="50" width="875" y="650" as="geometry" />
        </mxCell>
      </root>
