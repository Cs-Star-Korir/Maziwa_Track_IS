sword" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="265" width="270" height="20" as="geometry"/></mxCell><mxCell id="c18" value="••••••••" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;fontColor=#777777;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="285" width="270" height="34" as="geometry"/></mxCell><mxCell id="c19" value="Incorrect email or password. Please try again." style="html=1;whiteSpace=wrap;text;align=left;fontSize=12;fontColor=#c0392b;" vertex="1" parent="1"><mxGeometry x="40" y="325" width="270" height="30" as="geometry"/></mxCell><mxCell id="c20" value="Log in" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#2f5d50;fontColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="365" width="270" height="38" as="geometry"/></mxCell><mxCell id="c21" value="New farmer? Register here" style="html=1;whiteSpace=wrap;text;align=left;fontSize=12;fontColor=#2f5d50;fontStyle=4;" vertex="1" parent="1"><mxGeometry x="40" y="415" width="270" height="20" as="geometry"/></mxCell><mxCell id="c22" value="Need help?" style="html=1;whiteSpace=wrap;text;align=left;fontSize=12;fontColor=#2f5d50;fontStyle=4;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="270" height="20" as="geometry"/></mxCell><mxCell id="c23" value="Error state shown: wrong password. No 'forgot password' in the MVP." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="270" height="50" as="geometry"/></mxCell><mxCell id="c24" value="Full name" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="370" y="200" width="270" height="20" as="geometry"/></mxCell><mxCell id="c25" value="Wanjiku Mwangi" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;fontColor=#777777;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="220" width="270" height="32" as="geometry"/></mxCell><mxCell id="c26" value="Phone" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="370" y="262" width="270" height="20" as="geometry"/></mxCell><mxCell id="c27" value="0712 345 678" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;fontColor=#777777;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="282" width="270" height="32" as="geometry"/></mxCell><mxCell id="c28" value="Email" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="370" y="324" width="270" height="20" as="geometry"/></mxCell><mxCell id="c29" value="wanjiku@example.com" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;fontColor=#777777;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="344" width="270" height="32" as="geometry"/></mxCell><mxCell id="c30" value="Password" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="370" y="386" width="270" height="20" as="geometry"/></mxCell><mxCell id="c31" value="••••••••" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;fontColor=#777777;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="406" width="270" height="32" as="geometry"/></mxCell><mxCell id="c32" value="Confirm password" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="370" y="448" width="270" height="20" as="geometry"/></mxCell><mxCell id="c33" value="••••••••" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;fontColor=#777777;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="468" width="270" height="32" as="geometry"/></mxCell><mxCell id="c34" value="Create account" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#2f5d50;fontColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="520" width="270" height="38" as="geometry"/></mxCell><mxCell id="c35" value="Grader and admin accounts are created by the system administrator." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="370" y="565" width="270" height="40" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Farmers&lt;/b&gt;&lt;br&gt;1. Log in.&lt;br&gt;2. Click &lt;i&gt;Record delivery&lt;/i&gt; and enter the litres.&lt;br&gt;3. Note your batch number.&lt;br&gt;4. Check status; open the receipt once Paid.&lt;br&gt;&lt;br&gt;&lt;b&gt;Graders&lt;/b&gt;&lt;br&gt;1. Open &lt;i&gt;Batches to test&lt;/i&gt;.&lt;br&gt;2. Select a batch, enter measured litres.&lt;br&gt;3. Choose Pass or Reject and save.&lt;br&gt;&lt;br&gt;&lt;b&gt;Admin&lt;/b&gt;&lt;br&gt;1. Open &lt;i&gt;Approvals&lt;/i&gt;, review tested batches.&lt;br&gt;2. Approve payment; the farmer is emailed.&lt;br&gt;3. Use &lt;i&gt;Reports&lt;/i&gt; and &lt;i&gt;Audit log&lt;/i&gt; from the menu." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="200" width="275" height="330" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>