
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database (Supabase PostgreSQL).
# Supabase → your project → Connect → "Session pooler" → copy the URI and put your database password in it.
# Never commit the real value.
DATABASE_URL=postgresql://postgres.<project-ref>:<your-password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

JWT_SECRET=change-me-to-a-long-random-string
# true when the site is served over HTTPS (deployment)
COOKIE_SECURE=false

# Business settings
PRICE_PER_LITRE=50
COOPERATIVE_NAME=MaziwaTrack Dairy Cooperative
# Kenya time zone, used for batch-number dates and date filters (use the name, not +03:00)
TIME_ZONE=Africa/Nairobi

# Email: payment receipts, password reset links and 2FA login codes.
# Testing: Mailtrap's Email Testing sandbox (sandbox.smtp.mailtrap.io, port 2525). Demo: Gmail (below).
# Leave SMTP_HOST empty to print emails to the console instead.
# Gmail: smtp.gmail.com, port 587, and an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MaziwaTrack <no-reply@maziwatrack.co.ke>
# Address put into links inside emails (password reset). Your site's address when deployed.
APP_URL=http://localhost:5173

# Automated API tests (npm test). A SEPARATE, empty database: the tests delete all its data.
# Use a local PostgreSQL database or a second Supabase project, never the one in DATABASE_URL.
# Leave empty to skip the API tests (the unit and UI tests still run).
TEST_DATABASE_URL=

# ---------------- Frontend ----------------
# Only settings starting with VITE_ are sent to the browser.
# Backend address
VITE_API_URL=http://localhost:5000/api
# true = use the sample data in src/data (no backend needed); false = call the real API
VITE_USE_MOCK=false


