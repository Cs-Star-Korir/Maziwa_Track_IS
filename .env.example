
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database (MySQL / MariaDB in XAMPP). XAMPP's default is user root with no password.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=maziwatrack_db
DB_USER=root
DB_PASSWORD=

JWT_SECRET=change-me-to-a-long-random-string
# true when the site is served over HTTPS (deployment)
COOKIE_SECURE=false

# Business settings
PRICE_PER_LITRE=50
COOPERATIVE_NAME=MaziwaTrack Dairy Cooperative
# Kenya time, used for batch-number dates and date filters
LOCAL_TZ_OFFSET=+03:00

# Email to farmers when a payment is approved (optional while developing).
# Leave SMTP_HOST empty to print emails to the console instead.
# Gmail: smtp.gmail.com, port 587, and an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MaziwaTrack <no-reply@maziwatrack.co.ke>

# ---------------- Frontend ----------------
# Only settings starting with VITE_ are sent to the browser.
# Backend address
VITE_API_URL=http://localhost:5000/api
# true = use the sample data in src/data (no backend needed); false = call the real API
VITE_USE_MOCK=false
